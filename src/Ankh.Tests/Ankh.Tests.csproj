<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Commands\BlameCommandTest.cs" />
    <Compile Remove="Commands\CommitItemTest.cs" />
    <Compile Remove="Commands\LogCommandTest.cs" />
    <Compile Remove="StatusCacheTest.cs" />
    <Compile Remove="SvnItemTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Commands\BlameCommandTest.cs" />
    <Content Include="Commands\CommitItemTest.cs" />
    <Content Include="Commands\LogCommandTest.cs" />
    <Content Include="StatusCacheTest.cs" />
    <Content Include="SvnItemTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <ProjectReference Include="..\Ankh.Diff\Ankh.Diff.csproj" />
    <ProjectReference Include="..\Ankh.Ids\Ankh.Ids.csproj" />
    <ProjectReference Include="..\Ankh.Services\Ankh.Services.csproj" />
    <ProjectReference Include="..\Ankh.UI\Ankh.UI.csproj" />
    <ProjectReference Include="..\Ankh.VS\Ankh.VS.csproj" />
    <ProjectReference Include="..\Ankh\Ankh.csproj" />
    <ProjectReference Include="..\TestUtils\TestUtils.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="repos.zip" />
    <EmbeddedResource Include="repos2.zip" />
    <EmbeddedResource Include="unversioned.zip" />
    <EmbeddedResource Include="wc.zip" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="RhinoMocks" />
    <PackageReference Include="SharpSvn" GeneratePathProperty="true">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="UseX64SharpSvnForTests" AfterTargets="Build">
    <Copy SourceFiles="$(PkgSharpSvn)\runtimes\win-x64\lib\net40\SharpSvn.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(PkgSharpSvn)\runtimes\win-x64\lib\netcoreapp\SharpSvn-DB44-20-x64.svnDll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(PkgSharpSvn)\runtimes\win-x64\lib\netcoreapp\SharpPlink-x64.svnExe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>