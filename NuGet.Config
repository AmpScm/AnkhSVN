<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ARMoir" value="https://nuget.pkg.github.com/ARMoir/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ARMoir">
      <package pattern="SharpSvn" />
      <package pattern="SharpSvn.UI" />
    </packageSource>
  </packageSourceMapping>
</configuration>
